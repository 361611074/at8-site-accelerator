# 统一换行符：仓库内一律 LF，避免 Windows 开发 / Linux CI 之间的换行符噪音
* text=auto eol=lf

# PHP / JS / CSS / Markdown 明确用 LF
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf

# 二进制文件不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.gz    binary
*.mo    binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# 翻译文件：.pot 是文本（需要 diff），.mo 是二进制
*.pot   text eol=lf
*.po    text eol=lf

# 打包产物与测试产物不参与统计
dist/**            linguist-generated
tests/unit/fake-wp/** linguist-generated
languages/*.pot    linguist-generated
