name: CI

on:
  push:
    branches: [ main, master, develop ]
  pull_request:
    branches: [ main, master, develop ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # ---------------------------------------------------------------------------
  # 1. 语法检查 + 冒烟测试（PHP 版本矩阵）
  #
  # 插件声明 Requires PHP 7.4，但只在 7.4 上测是不够的：
  # PHP 8.x 移除了不少旧写法（花括号字符串下标、each()、create_function() 等），
  # 而 7.4 又能提前拦住"不小心用了 8.0 语法"。两头都要测。
  # ---------------------------------------------------------------------------
  test:
    name: PHP ${{ matrix.php }}
    runs-on: ubuntu-latest

    strategy:
      fail-fast: false
      matrix:
        php: [ '7.4', '8.0', '8.1', '8.2', '8.3' ]

    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 PHP ${{ matrix.php }}
        uses: shivammathur/setup-php@v2
        with:
          php-version: ${{ matrix.php }}
          coverage: none
          ini-values: error_reporting=E_ALL, display_errors=On

      - name: 语法检查（全部 PHP 文件）
        run: |
          set -e
          find . -name '*.php' -not -path './vendor/*' -print0 \
            | xargs -0 -n1 -P4 php -l

      - name: 冒烟测试
        run: php tests/unit/smoke.php

      - name: 翻译模板是否与源码同步
        run: |
          set -e
          php tools/make-pot.php
          if ! git diff --quiet -- languages/at8-site-accelerator.pot; then
            echo "::error::languages/at8-site-accelerator.pot 已过期。请在本地运行 php tools/make-pot.php 并提交结果。"
            git --no-pager diff --stat -- languages/at8-site-accelerator.pot
            exit 1
          fi

  # ---------------------------------------------------------------------------
  # 2. 带 Redis 的冒烟测试
  #
  # 上面那个 test 任务跑在没有 Redis 的 runner 上，覆盖的其实是"Redis 不可达 →
  # 降级磁盘"这条路径。而 Redis 可达时的分支（后端探测、Config 写 backend=redis、
  # 失效器打 Redis）在那边一行都没被执行过。
  #
  # 这不是假想的风险：2026-09-26 在真机（装了 Redis）验证时，正是因为存在这个盲区，
  # "失效器断言的是磁盘文件、实际清的却是 Redis" 的测试缺陷一直藏到部署才发现。
  # 现在补一个真正带 Redis 的 job，把这条路径纳入回归。
  # ---------------------------------------------------------------------------
  test-redis:
    name: 冒烟测试（Redis 后端）
    runs-on: ubuntu-latest

    services:
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          coverage: none
          ini-values: error_reporting=E_ALL, display_errors=On

      # 插件用的是纯 PHP RESP 客户端，不依赖 phpredis 扩展——
      # 这里刻意不装扩展，顺便验证"没有扩展也能连上"这个卖点。
      - name: 确认 Redis 可达
        run: |
          set -e
          php -r '$s = @fsockopen("127.0.0.1", 6379, $e, $m, 3); if (!$s) { fwrite(STDERR, "Redis 不可达: $m\n"); exit(1); } fwrite($s, "PING\r\n"); $r = fgets($s); fclose($s); if (false === strpos($r, "PONG")) { fwrite(STDERR, "PING 异常: $r\n"); exit(1); } echo "Redis OK (纯 PHP RESP 客户端)\n";'

      - name: 冒烟测试
        run: php tests/unit/smoke.php

  # ---------------------------------------------------------------------------
  # 3. 编码规范（WordPress Coding Standards）
  #
  # 阻断式：存量已清零（535 -> 0），从 3.0.1 起任何新增违规都会让 CI 变红。
  # phpcs.xml.dist 里每一处豁免都写了理由，豁免范围有据可查。
  # ---------------------------------------------------------------------------
  phpcs:
    name: PHPCS (WordPress 规范)
    runs-on: ubuntu-latest

    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          coverage: none
          tools: phpcs

      - name: 拉取 WordPress 规范
        run: |
          composer global config allow-plugins.dealerdirect/phpcodesniffer-composer-installer true
          composer global require --no-interaction wp-coding-standards/wpcs:^3 dealerdirect/phpcodesniffer-composer-installer

      - name: 执行 phpcs
        run: phpcs --standard=phpcs.xml.dist --report=summary --colors

  # ---------------------------------------------------------------------------
  # 4. 打包产物（打 tag 时生成，供人工下载检查）
  # ---------------------------------------------------------------------------
  package:
    name: 打包 Free 版 ZIP
    runs-on: ubuntu-latest
    needs: [ test ]
    if: startsWith( github.ref, 'refs/tags/v' )

    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          coverage: none

      - name: 打包
        run: php tools/build-zip.php

      - name: 上传产物
        uses: actions/upload-artifact@v4
        with:
          name: at8-site-accelerator-${{ github.ref_name }}
          path: dist/*.zip
          if-no-files-found: error
